{
  "name": "pcb-generation-benchmark01",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "score": "bun scripts/score-experiment.ts",
    "collect": "bun scripts/collect-pilot-results.ts",
    "rules": "bun scripts/author-scoring-rules.ts",
    "website:views": "bun website/render-pcb-views.ts",
    "website:build": "bun website/build.ts",
    "build": "bun run website:views && bun run website:build",
    "website:publish": "bun run build && ohmx-box publish-html --json website/dist --title 'PCB Generation Benchmark 01' --replace",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"website/*.{ts,tsx}\" \"website/*.css\" package.json tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"website/*.{ts,tsx}\" \"website/*.css\" package.json tsconfig.json"
  },
  "dependencies": {
    "@tscircuit/pcb-viewer": "1.11.393",
    "@xmldom/xmldom": "^0.9.12",
    "circuit-json": "0.0.485",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
